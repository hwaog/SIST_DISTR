# ─────────────────────────────────────────────────────────────────────────────────────────────
# DFSha · variables de un ControlNode  (`dfsha-control`; cada una equivale a un flag, ver `dfsha-control --help`)
#
# Docker Compose y deploy/aws las generan solas. Este ejemplo sirve para arrancar uno a mano:
#   cp docker/control.env.example c1.env  &&  (edite)  &&  set -a; source c1.env; set +a; dfsha-control
# ─────────────────────────────────────────────────────────────────────────────────────────────

# ── Identidad y red (obligatorias) ──────────────────────────────────────────────────────────
DFSHA_NODE_ID=c1
# TODOS los ControlNodes, incluido éste:  id=url_publica,url_interna;id=...   (la interna usa mTLS)
DFSHA_PEERS=c1=https://c1:8441,https://c1:9441;c2=https://c2:8442,https://c2:9442;c3=https://c3:8443,https://c3:9443
DFSHA_DATA_DIR=/data
# DFSHA_HOST=0.0.0.0

# ── Certificados y secretos (obligatorios) ──────────────────────────────────────────────────
# Certificado/clave de ESTE nodo (rol controlnode, emitido con `dfsha-pki issue`) y certificado público de la CA.
DFSHA_CERT=/pki/c1.crt
DFSHA_KEY=/pki/c1.key
DFSHA_CA=/pki/ca.pem
# Secreto maestro (cluster.key): IDÉNTICO en los 3 ControlNodes y NUNCA en un DataNode.
DFSHA_CLUSTER_SECRET_FILE=/secrets/cluster.key
# Clave del usuario admin en el primer arranque: en archivo (preferible) o directa.
DFSHA_ADMIN_PASSWORD_FILE=/secrets/admin.pass
# DFSHA_ADMIN_PASSWORD=cambie-esta-clave

# ── Política del sistema de archivos ────────────────────────────────────────────────────────
DFSHA_REPL=3
DFSHA_BLOCK_SIZE=4MiB
# Confirmaciones exigidas al escribir un bloque: majority | all | one
DFSHA_WRITE_QUORUM=majority

# ── Tolerancia a fallos y mantenimiento (segundos) ──────────────────────────────────────────
# Sin heartbeat durante este tiempo, un DataNode se declara muerto.
DFSHA_DN_DEAD_AFTER=10
# Espera adicional antes de re-replicar (evita mover datos por un fallo pasajero).
DFSHA_REPL_GRACE=15
# Gracia antes de borrar físicamente bloques huérfanos.
DFSHA_GC_GRACE=120
# Cada cuántos segundos corre el balanceador (0 = desactivado).
DFSHA_BALANCE_INTERVAL=30

DFSHA_LOG_LEVEL=info
