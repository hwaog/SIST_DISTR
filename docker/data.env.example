# ─────────────────────────────────────────────────────────────────────────────────────────────
# DFSha · variables de un DataNode  (`dfsha-data`; cada una equivale a un flag, ver `dfsha-data --help`)
#
# Docker Compose y deploy/aws las generan solas. Este ejemplo sirve para arrancar uno a mano:
#   cp docker/data.env.example dn1.env  &&  (edite)  &&  set -a; source dn1.env; set +a; dfsha-data
# Un DataNode NO recibe cluster.key: sólo su certificado, su clave y la CA.
# ─────────────────────────────────────────────────────────────────────────────────────────────

# ── Identidad y red (obligatorias) ──────────────────────────────────────────────────────────
DFSHA_NODE_ID=dn1
# URLs INTERNAS (mTLS) de los ControlNodes, separadas por coma.
DFSHA_CONTROLS=https://c1:9441,https://c2:9442,https://c3:9443
DFSHA_DATA_DIR=/data
# Puertos de escucha: público (clientes, TLS) e interno (entre nodos, mTLS).
DFSHA_API_PORT=7441
DFSHA_INTERNAL_PORT=7541
# URLs con las que otros alcanzan a este nodo (nombre o IP alcanzable desde clientes / desde los demás nodos).
DFSHA_ADVERTISE_PUBLIC=https://dn1:7441
DFSHA_ADVERTISE_INTERNAL=https://dn1:7541
# DFSHA_HOST=0.0.0.0

# ── Certificados (obligatorios) ─────────────────────────────────────────────────────────────
DFSHA_CERT=/pki/dn1.crt
DFSHA_KEY=/pki/dn1.key
DFSHA_CA=/pki/ca.pem

# ── Colocación y capacidad ──────────────────────────────────────────────────────────────────
# Zona / rack / zona de disponibilidad: las réplicas de un bloque se reparten entre zonas distintas.
DFSHA_ZONE=us-east-1a
# Tope de bytes que ofrece (p. ej. 50GiB). 0 = el espacio libre del disco.
DFSHA_CAPACITY=20GiB

# Segundos entre heartbeats al ControlNode.
DFSHA_HEARTBEAT=2
DFSHA_LOG_LEVEL=info
