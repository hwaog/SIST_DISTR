# ─────────────────────────────────────────────────────────────────────────────────────────────
# DFSha · Docker Compose  (3 ControlNodes + 5 DataNodes + cliente)
#
#   cp .env.example .env        # edite ADMIN_PASSWORD; .env NO se versiona (está en .gitignore)
#   docker compose build && docker compose up -d
#
# Otros ejemplos de configuración:
#   .env.client.example         cliente (CLI/SDK) contra un cluster ya desplegado
#   deploy/aws/.env.example     scripts de despliegue en AWS Academy
#   docker/control.env.example  variables de un ControlNode          docker/data.env.example  de un DataNode
# ─────────────────────────────────────────────────────────────────────────────────────────────

# OBLIGATORIA. Clave del usuario «admin»; sólo se usa en el primer arranque (bootstrap). Use una larga y propia.
ADMIN_PASSWORD=cambie-esta-clave-1234

# Factor de replicación por defecto (réplicas de cada bloque). 3 tolera la caída de 2 DataNodes.
DFSHA_REPL=3

# Tamaño de bloque por defecto de los archivos nuevos (p. ej. 1MiB, 4MiB, 64MiB).
DFSHA_BLOCK_SIZE=4MiB

# Capacidad que declara cada DataNode (0 = todo el espacio libre del disco).
DFSHA_DN_CAPACITY=20GiB
