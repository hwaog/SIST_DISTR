# ─────────────────────────────────────────────────────────────────────────────────────────────
# DFSha · scripts de deploy/aws (AWS Academy Learner Lab)
#
#   cp deploy/aws/.env.example deploy/aws/.env      # .env NO se versiona (está en .gitignore)
#
# Los scripts (launch.sh, gen-bundles.sh, deploy.sh, validate.sh, bench-remote.sh…) leen este archivo si existe.
# Una variable ya exportada en el terminal tiene prioridad sobre este archivo (p. ej. `N_DATA=6 ./launch.sh`).
# Formato: CLAVE=valor, una por línea, sin espacios alrededor del «=» y sin comentarios al final de la línea.
# Las credenciales de AWS (aws_access_key_id...) NO van aquí: están en ~/.aws/credentials (se renuevan en cada sesión del lab).
# ─────────────────────────────────────────────────────────────────────────────────────────────

# ── Cuenta y acceso ─────────────────────────────────────────────────────────────────────────
# Región (el laboratorio sólo permite us-east-1 y us-west-2).
AWS_REGION=us-east-1
# Clave SSH del laboratorio (botón «Download PEM»), con permisos 400.
KEY_FILE=~/labsuser.pem
# Nombre del key pair en EC2 (en el Learner Lab se llama vockey) y usuario SSH de la AMI Amazon Linux.
KEY_NAME=vockey
SSH_USER=ec2-user
# Desde qué IP/rango se aceptan SSH y las APIs de cliente: su IP pública /32 (`curl https://checkip.amazonaws.com`).
# 0.0.0.0/0 abre a todo Internet (las APIs siguen exigiendo TLS + autenticación): úselo sólo si hace falta y por poco tiempo.
ALLOW_CIDR=203.0.113.10/32

# ── Contraseñas (¡cámbielas!) ───────────────────────────────────────────────────────────────
# Clave inicial del usuario admin: sólo la primera vez que se ejecuta gen-bundles.sh.
ADMIN_PASSWORD=cambie-esta-clave-larga
# Clave de admin con la que validate.sh y bench-remote.sh inician sesión.
DFSHA_PASSWORD=cambie-esta-clave-larga

# ── Tamaño del despliegue ───────────────────────────────────────────────────────────────────
N_CONTROL=3
N_DATA=4
# 1 = crea una VM cliente dentro del VPC (necesaria para medir con bench-remote.sh); 0 = sin cliente.
N_CLIENT=1
INSTANCE_TYPE=t3.small
CLIENT_TYPE=t3.medium
DATA_DISK_GB=30
VOLUME_TYPE=gp3
# 1 = IP elástica para cada VM (direcciones estables si se reinicia el lab; consume cuota).
USE_EIP=0
# Capacidad que declara cada DataNode (debe caber en DATA_DISK_GB).
DFSHA_DN_CAPACITY=20GiB

# ── Benchmarks (bench-remote.sh) ────────────────────────────────────────────────────────────
SIZE_MIB=256
REPS=3
