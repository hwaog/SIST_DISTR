# ─────────────────────────────────────────────────────────────────────────────────────────────
# DFSha · cliente (CLI `dfsha` y SDK de Python) contra un cluster YA desplegado
#
#   cp .env.client.example .env.client       # edite los valores; .env.client NO se versiona
#
# Cargarlo en la sesión actual del terminal:
#   macOS / Linux (bash, zsh):   set -a; source .env.client; set +a
#   Windows (PowerShell):        Get-Content .env.client | Where-Object { $_ -match '^\s*[A-Z_]+=' } |
#                                  ForEach-Object { $k,$v = $_ -split '=',2; Set-Item "env:$k" $v.Trim('"') }
# Después:  uv run dfsha login -u "$DFSHA_USER" -p "$DFSHA_PASSWORD"   (PowerShell: $env:DFSHA_USER / $env:DFSHA_PASSWORD)
# (Las líneas que empiezan por # son comentarios; no ponga comentarios al final de una línea de valores.)
# ─────────────────────────────────────────────────────────────────────────────────────────────

# URLs PÚBLICAS de los ControlNodes, separadas por coma (el cliente prueba una tras otra si alguna cae).
#   Docker Compose desde el host: https://c1:8441,https://c2:8442,https://c3:8443   (los nombres deben resolver a 127.0.0.1)
#   AWS Academy: copie la línea DFSHA_ENDPOINTS de deploy/aws/client/env.sh
DFSHA_ENDPOINTS=https://c1.ejemplo.com:8441,https://c2.ejemplo.com:8442,https://c3.ejemplo.com:8443

# Certificado público de la CA del cluster (ca.pem): el cliente verifica con él que habla con el cluster verdadero.
#   AWS: deploy/aws/client/ca.pem        Docker: docker run --rm -v dfsha_pki-client:/pki alpine cat /pki/ca.pem > ca.pem
DFSHA_CA=./ca.pem

# Cuenta con la que se inicia sesión.
DFSHA_USER=admin
DFSHA_PASSWORD=cambie-esta-clave

# Opcionales ─────────────────────────────────────────────────────────────────────────────────
# Carpeta donde el CLI guarda la sesión (por defecto ~/.dfsha). Útil para usar dos cuentas a la vez.
# DFSHA_HOME=./.dfsha-sesion
# Transferencias de bloques en paralelo (por defecto 8).
# DFSHA_WORKERS=8
# API key (alternativa a usuario/clave para automatización; se crea con `dfsha apikey-create`).
# DFSHA_API_KEY=dfsha_ak_xxxxxxxx.xxxxxxxxxxxxxxxx
